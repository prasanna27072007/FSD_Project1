# Local MongoDB. Replace with your MongoDB Atlas connection string if using Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/hdss

# Replace this with a long, random secret before using outside local development.
JWT_SECRET=replace-with-a-long-random-secret
PORT=5003
CLIENT_URL=http://localhost:5173

# Development only: use temporary demo data if the configured database is unreachable.
ALLOW_MEMORY_FALLBACK=true
