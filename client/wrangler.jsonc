{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fsd-project1",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-21",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/socket.io", "/socket.io/*"],
    "not_found_handling": "single-page-application"
  },
  "containers": [
    {
      "class_name": "Backend",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "../server/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "exports": {
    "Backend": { "type": "durable-object", "storage": "sqlite" }
  }
}
